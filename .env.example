# Meta system-user access token (Business Manager > Users > System users > Generate token)
# Needs: pages_show_list, pages_read_engagement, read_insights (and business_management)
META_SYSTEM_USER_TOKEN=

# Optional: Graph API version (default v26.0)
META_API_VERSION=v26.0

# Postgres connection string. Added automatically when you connect Neon in Vercel > Storage.
DATABASE_URL=

# Random string. Vercel sends it to /api/sync as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Dashboard login (browser username/password prompt). Leave both empty to rely on Vercel Deployment Protection only.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
